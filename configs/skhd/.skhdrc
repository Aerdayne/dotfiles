# Most of the keybindings and commands are taken from https://github.com/atidyshirt/MacOS-Dotfiles/blob/master/.skhdrc
# The "# Category: Description" comment above a binding is its label in the Hyper + Space overlay

# Navigation: Focus left
alt - h [
    *           : yabai -m window --focus west
    "Alacritty" : ~/.config/yabai/focus-pane-or-window.sh west
]

# Navigation: Focus down
alt - j [
    *           : yabai -m window --focus south
    "Alacritty" : ~/.config/yabai/focus-pane-or-window.sh south
]

# Navigation: Focus up
alt - u [
    *           : yabai -m window --focus north
    "Alacritty" : ~/.config/yabai/focus-pane-or-window.sh north
]

# Navigation: Focus right
alt - k [
    *           : yabai -m window --focus east
    "Alacritty" : ~/.config/yabai/focus-pane-or-window.sh east
]

# Windows: Move left
shift + alt - h : yabai -m window --warp west
# Windows: Move down
shift + alt - j : yabai -m window --warp south
# Windows: Move up
shift + alt - u : yabai -m window --warp north
# Windows: Move right
shift + alt - k : yabai -m window --warp east

# Windows: Grow left
shift + alt - a : yabai -m window --resize left:-30:0
# Windows: Grow down
shift + alt - s : yabai -m window --resize bottom:0:30
# Windows: Grow up
shift + alt - w : yabai -m window --resize top:0:-30
# Windows: Grow right
shift + alt - d : yabai -m window --resize right:30:0

# Windows: Shrink left
shift + cmd - a : yabai -m window --resize left:30:0
# Windows: Shrink down
shift + cmd - s : yabai -m window --resize bottom:0:-30
# Windows: Shrink up
shift + cmd - w : yabai -m window --resize top:0:30
# Windows: Shrink right
shift + cmd - d : yabai -m window --resize right:-30:0

# Windows: Balance window sizes
shift + alt - 0 : yabai -m space --balance

# Spaces: Destroy current space
shift + alt - q : yabai -m space --destroy

# Spaces: Create new space and move focused window
shift + alt - n : /bin/bash -c "yabai -m space --create && \
                  index=\"\$(yabai -m query --spaces --display | jq 'map(select(.\"is-native-fullscreen\" == false))[-1].index')\" && \
                  yabai -m window --space \"\${index}\" && \
                  yabai -m space --focus \"\${index}\""

# Spaces: Create new space
shift + alt - m : /bin/bash -c "yabai -m space --create && \
                 index=\"\$(yabai -m query --spaces --display | jq 'map(select(.\"is-native-fullscreen\" == false))[-1].index')\" && \
                 yabai -m space --focus \"\${index}\""


# Navigation: Focus space
alt - 1 : yabai -m space --focus 1
alt - 2 : yabai -m space --focus 2
alt - 3 : yabai -m space --focus 3
alt - 4 : yabai -m space --focus 4
alt - 5 : yabai -m space --focus 5
alt - 6 : yabai -m space --focus 6
alt - 7 : yabai -m space --focus 7
alt - 8 : yabai -m space --focus 8
alt - 9 : yabai -m space --focus 9

# Navigation: Focus previous space
ctrl - left : ~/.config/yabai/focus-adjacent-space.sh prev
# Navigation: Focus next space
ctrl - right : ~/.config/yabai/focus-adjacent-space.sh next

# Windows: Send window to space
shift + cmd - 1 : yabai -m window --space 1; yabai -m space --focus 1
shift + cmd - 2 : yabai -m window --space 2; yabai -m space --focus 2
shift + cmd - 3 : yabai -m window --space 3; yabai -m space --focus 3
shift + cmd - 4 : yabai -m window --space 4; yabai -m space --focus 4
shift + cmd - 5 : yabai -m window --space 5; yabai -m space --focus 5
shift + cmd - 6 : yabai -m window --space 6; yabai -m space --focus 6
shift + cmd - 7 : yabai -m window --space 7; yabai -m space --focus 7
shift + cmd - 8 : yabai -m window --space 8; yabai -m space --focus 8
shift + cmd - 9 : yabai -m window --space 9; yabai -m space --focus 9

# Navigation: Focus monitor
ctrl + cmd - 1 : yabai -m display --focus 1
ctrl + cmd - 2 : yabai -m display --focus 2
ctrl + cmd - 3 : yabai -m display --focus 3

# Windows: Send window to monitor
ctrl + alt - 1 : yabai -m window --display 1; yabai -m display --focus 1
ctrl + alt - 2 : yabai -m window --display 2; yabai -m display --focus 2
ctrl + alt - 3 : yabai -m window --display 3; yabai -m display --focus 3

# Layout: Insert left
shift + cmd - h : yabai -m window --insert west
# Layout: Insert down
shift + cmd - j : yabai -m window --insert south
# Layout: Insert up
shift + cmd - u : yabai -m window --insert north
# Layout: Insert right
shift + cmd - k : yabai -m window --insert east

# Spaces: Move space left
hyper - left : yabai -m space --move prev
# Spaces: Move space right
hyper - right : yabai -m space --move next

# Layout: Rotate space
alt - r : yabai -m space --rotate 90

# Layout: Mirror space on y-axis
alt - y : yabai -m space --mirror y-axis

# Layout: Toggle padding and gaps
alt - a : yabai -m space --toggle padding; yabai -m space --toggle gap

# Windows: Zoom over parent
alt - d : yabai -m window --toggle zoom-parent

# Windows: Toggle fullscreen zoom
alt - f : yabai -m window --toggle zoom-fullscreen

# Layout: Toggle split orientation
alt - e : yabai -m window --toggle split

# Layout: Set layout mode
shift + alt - z : yabai -m space --layout bsp
shift + alt - x : yabai -m space --layout float
shift + alt - c : yabai -m space --layout stack

.blacklist [
    "terminal"
    "Wow"
]
