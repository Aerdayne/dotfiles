{
  "workbench.colorCustomizations": {
    "peekViewEditor.matchHighlightBackground": "#ff990043",
  },
  "solargraph.commandPath": "",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.defaultProfile.osx": "Fish",
  "terminal.integrated.profiles.osx": {
    "Fish": {
      "path": ["/opt/homebrew/bin/fish"],
      "args": ["-l"],
      "icon": "terminal-cmd",
    },
  },
  "terminal.integrated.automationProfile.osx": {
    "path": "/bin/sh",
  },
  "ruby.rubocop.suppressRubocopWarnings": true,
  "ruby.rubocop.executePath": "~/.asdf/shims/",
  "editor.tabSize": 2,
  "git.suggestSmartCommit": false,
  "markdown.extension.toc.updateOnSave": false,
  "terminal.external.osxExec": "Alacritty.app",
  "terminal.integrated.fontFamily": "Iosevka",
  "terminal.integrated.fontSize": 14.0,
  "redhat.telemetry.enabled": false,
  "ruby.rubocop.useBundler": true,
  "diffEditor.codeLens": true,
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "yaml": false,
  },
  "standardRuby.mode": "enableUnconditionally",
  "diffEditor.ignoreTrimWhitespace": false,
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.fileListLayout": "tree",
  "workbench.colorTheme": "Gruvbox Dark Medium",
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true,
    },
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "editor.multiCursorModifier": "ctrlCmd",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
  },
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "ruff.path": [
    "${userHome}/.local/share/mise/installs/ruff/0.6.4/ruff-aarch64-apple-darwin/ruff",
  ],
  "git.blame.editorDecoration.enabled": false,
  "[helm]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "python.languageServer": "None",
  "gitlens.ai.model": "gitkraken",
  "gitlens.ai.gitkraken.model": "gemini:gemini-2.5-flash",
}
