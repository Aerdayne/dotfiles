#!/usr/bin/env sh

# After yabai updates: ./configs/yabai/setup-yabai-sudoers.sh && yabai --restart-service
# Without a matching sudoers entry this can't prompt for a password (no terminal), so say so instead
load_sa='sudo -n yabai --load-sa || osascript -e "display notification \"Run configs/yabai/setup-yabai-sudoers.sh\" with title \"yabai: scripting addition not loaded\""'
sh -c "$load_sa"
yabai -m signal --add label=load_sa_on_dock_restart event=dock_did_restart action="$load_sa"

# Recompute the layout of spaces dragged to another display in Mission Control (see the script)
yabai -m signal --add label=refresh_moved_spaces_start event=mission_control_enter action="$HOME/.config/yabai/refresh-moved-spaces.sh start"
yabai -m signal --add label=refresh_moved_spaces_stop event=mission_control_exit action="$HOME/.config/yabai/refresh-moved-spaces.sh stop"

# True Tone only while the MacBook is used without external displays (see the script)
yabai -m signal --add label=sync_true_tone_added event=display_added action="$HOME/.config/yabai/sync-true-tone.js"
yabai -m signal --add label=sync_true_tone_removed event=display_removed action="$HOME/.config/yabai/sync-true-tone.js"
"$HOME/.config/yabai/sync-true-tone.js"

# Remove the black bar macOS sometimes leaves stuck behind the MacBook's menu bar (see the script)
for event in space_changed display_added display_removed display_moved display_resized system_woke mission_control_exit; do
    yabai -m signal --add label="fix_notch_shield_$event" event="$event" action="$HOME/.config/yabai/fix-notch-shield.sh $event"
done

yabai -m config mouse_follows_focus          off
yabai -m config focus_follows_mouse          off
yabai -m config window_placement             second_child
yabai -m config window_shadow               off
yabai -m config window_opacity               off
yabai -m config window_opacity_duration      0.10
yabai -m config active_window_opacity        1.00
yabai -m config normal_window_opacity        1.00

yabai -m config split_ratio                  0.50
yabai -m config auto_balance                 on

yabai -m config mouse_modifier               fn
yabai -m config mouse_action1                move
yabai -m config mouse_action2                resize
yabai -m config mouse_drop_action            swap

yabai -m config insert_feedback_color        0xffd75f5f

yabai -m config layout                       bsp
yabai -m config top_padding                  6
yabai -m config bottom_padding               6
yabai -m config left_padding                 6
yabai -m config right_padding                6
yabai -m config window_gap                   6

yabai -m rule --add app="^System Settings$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Preview$" manage=off
yabai -m rule --add app="^OpenVPN" manage=off
yabai -m rule --add app="^Wow$" manage=off
yabai -m rule --add app="^Noggit 3$" title!="^Noggit - " manage=off
yabai -m rule --add app="^Notes" manage=off
yabai -m rule --add app="^Finder" manage=off
yabai -m rule --add app="^QuickTime Player" manage=off
yabai -m rule --add title="^Picture in Picture$" manage=off sticky=on
